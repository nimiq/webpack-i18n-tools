{
  "name": "webpack-i18n-tools",
  "version": "1.0.0",
  "description": "Tools for internationalizing Vue applications and component libraries with gettext .po files: an extractor, and a loader and optimizer for Rollup, Rolldown and Vite.",
  "license": "MIT",
  "author": "Mathéo <matheo.raveux@gmail.com>",
  "repository": "https://github.com/nimiq/webpack-i18n-tools.git",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./extractor": "./src/extractor.js",
    "./json-lib": "./src/json-lib.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "i18n-tools": "./src/cli.js"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
