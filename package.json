{
    "name": "webpack-i18n-tools",
    "version": "1.0.0",
    "description": "Tools for internationalizing Vue applications and component libraries with gettext .po files: an extractor, and a loader and optimizer for Rollup, Rolldown and Vite.",
    "license": "MIT",
    "author": "Mathéo <matheo.raveux@gmail.com>",
    "repository": "https://github.com/nimiq/webpack-i18n-tools.git",
    "bin": {
        "i18n-tools": "./src/cli.js"
    },
    "files": [
        "src",
        "types"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./src/index.js"
        },
        "./extractor": {
            "types": "./types/extractor.d.ts",
            "default": "./src/extractor.js"
        },
        "./json-lib": {
            "types": "./types/json-lib.d.ts",
            "default": "./src/json-lib.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "types": "tsc -p tsconfig.types.json",
        "test": "vp test"
    },
    "dependencies": {
        "@rollup/pluginutils": "^5.5.1",
        "gettext-extractor": "^4.0.6",
        "gettext-parser": "^10.0.0",
        "parse5-sax-parser": "^8.0.1",
        "webpack-sources": "^3.7.1"
    },
    "devDependencies": {
        "@jridgewell/trace-mapping": "^0.3.31",
        "@types/gettext-parser": "^9.0.0",
        "@types/node": "^22.20.5",
        "rolldown": "^1.3.3",
        "rollup": "^4.68.8",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
        "vite-plus": "^1.8.0"
    },
    "peerDependencies": {
        "vite": ">=5.0.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "engines": {
        "node": "^22.17.0 || >=24.0.0"
    },
    "packageManager": "pnpm@12.23.0"
}
