    "gettext-extractor": "^3.7.2",
    "gettext-parser": "^10.0.0",
    "parse5-sax-parser": "^7.0.0",
    "webpack-sources": "^3.2.3"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/node": "^20.3.1",
    "rolldown": "^1.3.3",
    "rollup": "^4.68.8",
    "typescript": "^5.1.3",
    "vite-plus": "^1.8.0"
  }
}
