{
    "compilerOptions": {
        "target": "es2023",
        "module": "nodenext",
        "lib": ["es2023"],
        "types": ["node"],
        "allowJs": true,
        "checkJs": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src", "test", "vite.config.ts"],
    "exclude": ["test/fixtures"]
}
